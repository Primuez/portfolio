{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "scripts/worker-shim.js",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
