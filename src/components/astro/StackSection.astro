---
import SectionHeader from './SectionHeader.astro';

const STACK_GROUPS = [
  {
    title: 'Automation & Orchestration',
    border: 'cyan',
    items: [
      { name: 'n8n Workflow Engine', desc: 'Self-hosted workflow orchestration, complex multi-node graphs & automated error recovery', badge: 'CORE' },
      { name: 'Python 3.13 Runtime', desc: 'Custom scraping, data normalization, NLP parsing & computer vision pipelines', badge: 'LANGUAGE' },
      { name: 'Docker & Linux VPS', desc: 'Hostinger Linux VPS, containerized microservices behind Traefik reverse proxy', badge: 'INFRA' },
      { name: 'Webhooks & Native Crons', desc: 'Sub-second event dispatch and reliable 24/7 background state synchronization', badge: 'DAEMONS' },
    ]
  },
  {
    title: 'Edge & Backend Systems',
    border: 'amber',
    items: [
      { name: 'Cloudflare Workers & D1', desc: 'Serverless edge compute with D1 relational database and R2 media storage', badge: 'EDGE' },
      { name: 'Hono.js Micro-Framework', desc: 'Ultrafast, lightweight TypeScript API layer running at edge scale', badge: 'FRAMEWORK' },
      { name: 'Supabase & Postgres', desc: 'Relational data persistence, row-level security & pgvector embeddings', badge: 'DATABASE' },
      { name: 'Traefik Reverse Proxy', desc: 'Dynamic load balancing with automated Let\'s Encrypt SSL management', badge: 'ROUTING' },
    ]
  },
  {
    title: 'AI, LLMs & Cognitive Layers',
    border: 'cyan',
    items: [
      { name: 'Google Gemini 2.5/3.0', desc: 'Multimodal vision, high-speed tool calling & structured schema enforcement', badge: 'API_LLM' },
      { name: 'DeepSeek & Ollama', desc: 'Cost-effective reasoning models with private local host fallback paths', badge: 'LOCAL_AI' },
      { name: 'Mistral OCR & LangChain', desc: 'High-speed document parsing, chain logic & deterministic financial calculations', badge: 'RAG' },
      { name: 'Whisper & Edge TTS', desc: 'Sub-second audio processing, native voice bubbles & transcription pipes', badge: 'AUDIO' },
    ]
  },
  {
    title: 'Enterprise & Business Rails',
    border: 'amber',
    items: [
      { name: 'Odoo ERP Ecosystem', desc: 'JSON-RPC integration with CRM, sales orders, inventory & automated attendance', badge: 'ERP' },
      { name: 'Evolution API (WhatsApp)', desc: 'Multi-instance message queues, token refreshes & automated client nurture', badge: 'MESSAGING' },
      { name: 'IndiaMART Lead Webhooks', desc: 'Automated inbound inquiry capture, schema parsing & instant CRM routing', badge: 'LEADS' },
      { name: 'GST & Compliance Logic', desc: 'Section 16(2)(aa) verification, reconciliation & PDF invoice automation', badge: 'TAX_ENG' },
    ]
  }
];
---

<section id="stack" class="pt-20 md:pt-32 pb-16 scroll-mt-20 overflow-hidden">
  <SectionHeader number="08" command="> neofetch --architecture" title="Tech Stack & Infrastructure" />

  <p class="text-zinc-400 mt-2 mb-12 max-w-2xl text-base leading-relaxed font-sans">
    Battle-tested systems engineered for maximum uptime, minimum latency, and zero unnecessary dependencies.
  </p>

  {/* Modular Chip Matrix with Double-Bezel Architecture */}
  <div id="stack-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {STACK_GROUPS.map((group) => (
      <div class={`stack-card p-1.5 rounded-[2rem] bg-gradient-to-b ${
        group.border === 'cyan'
          ? 'from-cyan/20 via-white/[0.03] to-transparent border border-cyan/30'
          : 'from-amber/20 via-white/[0.03] to-transparent border border-amber/30'
      } shadow-2xl backdrop-blur-xl transition-all duration-300 hover:border-white/40`}>
        
        <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-7 flex flex-col justify-between h-full">
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-3.5 mb-5">
            <h3 class={`text-sm sm:text-base font-bold font-mono uppercase tracking-wider ${
              group.border === 'cyan' ? 'text-cyan' : 'text-amber'
            }`}>
              // {group.title}
            </h3>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>

          <div class="space-y-3.5">
            {group.items.map((item) => (
              <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05] flex items-start justify-between gap-3 hover:border-cyan/30 hover:bg-white/[0.04] transition-all">
                <div>
                  <span class="text-white text-sm font-bold font-sans block">{item.name}</span>
                  <span class="text-zinc-400 text-xs leading-relaxed font-sans block mt-0.5">{item.desc}</span>
                </div>
                <span class="font-mono text-[9px] uppercase px-2 py-0.5 rounded bg-white/5 text-cyan border border-cyan/20 shrink-0 mt-0.5 font-bold">
                  {item.badge}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const stackGrid = document.querySelector('#stack-grid');
    const cards = document.querySelectorAll('.stack-card');

    if (stackGrid && cards.length) {
      // Staggered diagonal matrix entrance (x: -30, y: 30)
      gsap.from(cards, {
        x: -30,
        y: 30,
        opacity: 0,
        stagger: 0.15,
        duration: 0.85,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: stackGrid,
          start: 'top 85%',
        },
      });
    }
  }
</script>
