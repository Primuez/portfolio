---
import SectionHeader from './SectionHeader.astro';

const CHIPS = ['n8n Orchestration', 'Mistral OCR', 'Supabase Vector', 'Python AI', 'Docker Container', 'Cloudflare Edge', 'LangChain', 'Ollama Local'];
---

<section id="videos" class="pt-20 md:pt-32 pb-16 scroll-mt-20 overflow-hidden">
  <SectionHeader number="04" command="> ./content --media" title="Video Presentations & Playlists" />

  <p class="text-zinc-400 mt-2 mb-8 max-w-2xl text-base leading-relaxed font-sans">
    Detailed walkthroughs of live n8n workflows, multi-agent cognitive layers, and enterprise architecture setups.
  </p>

  {/* Floating Tech Chips Row */}
  <div class="flex flex-wrap gap-2 mb-10">
    {CHIPS.map((chip, i) => (
      <span class={`font-mono text-[10px] uppercase tracking-wider px-3.5 py-1.5 rounded-full border backdrop-blur-md ${
        i % 3 === 0 
          ? 'border-cyan/40 text-cyan bg-cyan/5 shadow-[0_0_12px_rgba(0,240,255,0.15)]' 
          : i % 3 === 1 
            ? 'border-amber/40 text-amber bg-amber/5 shadow-[0_0_12px_rgba(245,166,35,0.15)]' 
            : 'border-white/20 text-zinc-300 bg-white/5'
      }`}>
        {chip}
      </span>
    ))}
  </div>

  {/* Cinematic Media Rack with Unique Clip-Path Scroll Reveal */}
  <div id="video-rack-container" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    
    {/* Featured Cinematic Showcase (Left / 7 cols) with Inset Clip-Path Mask Expansion */}
    <div class="lg:col-span-7 video-cinematic-feature p-1.5 rounded-[2rem] bg-gradient-to-b from-cyan/20 via-white/[0.04] to-transparent border border-white/10 shadow-[0_25px_60px_rgba(0,0,0,0.8)] backdrop-blur-2xl">
      <div class="video-mask-expand rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-8 flex flex-col justify-between h-full relative overflow-hidden">
        
        {/* Top Video Status Banner */}
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
            <span class="font-mono text-xs uppercase tracking-widest text-zinc-300 font-bold">TRANSMISSION // 4K_STUDIO</span>
          </div>
          <span class="font-mono text-[10px] text-cyan bg-cyan/10 border border-cyan/30 px-2.5 py-0.5 rounded-full">
            FEATURED CURATION
          </span>
        </div>

        {/* Video Preview Graphic Frame */}
        <div class="relative w-full aspect-video rounded-2xl bg-gradient-to-tr from-black via-[#0d1527] to-cyan/10 border border-white/10 flex items-center justify-center p-6 mb-6 overflow-hidden group">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,240,255,0.15),transparent_70%)]"></div>
          
          <div class="w-16 h-16 rounded-full bg-cyan/20 border border-cyan/50 flex items-center justify-center text-cyan text-2xl group-hover:scale-110 group-hover:bg-cyan group-hover:text-black transition-all duration-300 shadow-[0_0_30px_rgba(0,240,255,0.4)] z-10">
            ▶
          </div>

          <div class="absolute bottom-3 left-4 font-mono text-[11px] text-zinc-400 z-10">
            AUTONOMOUS ENTERPRISE BLUEPRINTS // YOUTUBE
          </div>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-white mb-2.5 font-sans">
            Autonomous Enterprise Orchestration & Playlists
          </h3>
          <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-6 font-sans">
            Access curated masterclasses detailing multi-agent architectures, n8n webhook pipelines, and error-recovery circuits for enterprise deployments.
          </p>

          <a
            href="https://www.youtube.com/@Primuez/playlists"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-cyan/15 hover:bg-cyan hover:text-black border border-cyan/40 text-cyan font-mono text-xs uppercase tracking-widest font-bold transition-all duration-300 shadow-[0_0_20px_rgba(0,240,255,0.2)]"
          >
            <span>Explore Playlists</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    {/* Secondary Transmission Feed (Right / 5 cols) */}
    <div class="lg:col-span-5 video-secondary-feature p-1.5 rounded-[2rem] bg-gradient-to-b from-rose-500/20 via-white/[0.04] to-transparent border border-white/10 shadow-[0_25px_60px_rgba(0,0,0,0.8)] backdrop-blur-2xl">
      <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-8 flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
            <span class="font-mono text-xs uppercase tracking-widest text-rose-400 font-bold">
              SUBSCRIBE // FEED
            </span>
            <span class="font-mono text-[10px] text-zinc-400">@Primuez</span>
          </div>

          <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center mb-6 text-rose-400 text-3xl shadow-[0_0_25px_rgba(244,63,94,0.2)]">
            📺
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 font-sans">
            Subscribe to Primuez
          </h3>
          <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed mb-6 font-sans">
            Live code breakdowns, real client automation teardowns, and continuous releases of verified n8n templates and AI agent tools.
          </p>
        </div>

        <a
          href="https://youtube.com/@Primuez"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-6 py-3.5 rounded-xl bg-rose-500/15 hover:bg-rose-500 hover:text-white border border-rose-500/40 text-rose-400 font-mono text-xs uppercase tracking-widest font-bold transition-all duration-300 shadow-[0_0_20px_rgba(244,63,94,0.2)]"
        >
          Watch on YouTube &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#videos');
    const maskTarget = document.querySelector('.video-mask-expand');
    const secondaryCard = document.querySelector('.video-secondary-feature');

    if (section && maskTarget) {
      // Unique Clip-Path Mask Expansion on Scroll
      gsap.fromTo(
        maskTarget,
        {
          clipPath: 'inset(12% 12% 12% 12% round 1.5rem)',
          scale: 0.94,
          opacity: 0.6,
        },
        {
          clipPath: 'inset(0% 0% 0% 0% round 1.625rem)',
          scale: 1,
          opacity: 1,
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#video-rack-container',
            start: 'top 80%',
            end: 'top 30%',
            scrub: 0.5,
          },
        }
      );

      if (secondaryCard) {
        gsap.from(secondaryCard, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: secondaryCard,
            start: 'top 85%',
          },
        });
      }
    }
  }
</script>
