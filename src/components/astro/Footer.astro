<footer aria-label="Site footer" class="footer-curtain-reveal border-t border-white/10 bg-[#05070c] relative z-10 py-16 md:py-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    <div class="p-1.5 rounded-[2.5rem] bg-gradient-to-b from-white/10 via-white/[0.02] to-transparent border border-white/10 shadow-2xl backdrop-blur-xl mb-12">
      <div class="rounded-[calc(2.5rem-0.375rem)] bg-[#070b12]/95 p-8 sm:p-12 flex flex-col md:flex-row justify-between items-center gap-8 text-center md:text-left">
        
        <div>
          <span class="font-mono text-cyan text-2xl sm:text-3xl tracking-widest font-extrabold block mb-1">
            PRIMUEZ
          </span>
          <span class="font-mono text-xs uppercase tracking-wider text-zinc-400 block mb-2">
            Autonomous Systems Builder &amp; n8n Specialist
          </span>
          <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-zinc-300">RAIPUR CORE // INDIA · OPEN FOR SELECT WORK</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href="mailto:contact@primuez.in"
            class="px-6 py-3.5 bg-cyan/15 hover:bg-cyan hover:text-black border border-cyan/40 text-cyan text-xs font-mono uppercase tracking-widest rounded-xl transition-all duration-300 font-bold shadow-[0_0_15px_rgba(0,240,255,0.15)]"
          >
            contact@primuez.in
          </a>
          <a
            href="https://cal.com/prime-s/30min"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-white/5 hover:border-white/30 text-white border border-white/10 text-xs font-mono uppercase tracking-widest rounded-xl transition-all duration-300 font-bold"
          >
            Cal.com ↗
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-6 font-mono text-xs text-zinc-500 pt-4 border-t border-white/[0.06]">
      <div class="flex items-center gap-6">
        <a href="https://github.com/primuez" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">GitHub</a>
        <a href="https://youtube.com/@Primuez" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">YouTube</a>
        <a href="https://linkedin.com/in/rahul-kasturiya-796910363" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">LinkedIn</a>
        <a href="https://x.com/Primuez" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">X / Twitter</a>
      </div>

      <div class="text-zinc-500 text-center sm:text-right">
        &copy; 2026 Primuez (Rahul Kasturiya) &middot; Zero WebGL &middot; 100% Autonomic
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const footer = document.querySelector('.footer-curtain-reveal');
    if (footer) {
      // Underneath reveal animation from bottom
      gsap.from(footer, {
        y: 60,
        opacity: 0.8,
        ease: 'none',
        scrollTrigger: {
          trigger: footer,
          start: 'top 95%',
          end: 'bottom bottom',
          scrub: 0.5,
        },
      });
    }
  }
</script>
