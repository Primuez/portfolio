---
import SectionHeader from './SectionHeader.astro';

const WHY_ITEMS = [
  {
    num: '01',
    metric: '100%',
    metricLabel: 'PRODUCTION SHIPPED',
    title: 'We Ship, Not Just Plan',
    detail: "Real products. Live URLs. InkTwin and PrimuezSure aren't concepts on a slide deck — they're deployed, working SaaS tools built by a solo developer from central India.",
    extended: "We engineer the complete lifecycle: responsive interfaces, resilient background workers, and automated security controls. We deploy the exact execution we use to power our own live tools."
  },
  {
    num: '02',
    metric: '3h/day',
    metricLabel: 'SAVED PER OPERATOR',
    title: 'Automation-First Thinking',
    detail: 'Every solution starts with: what can be automated? Powered by n8n, LLMs, autonomous agents, and custom API pipelines — manual work is eliminated at the source.',
    extended: 'Every operational bottleneck is solved at the architecture level. By combining high-density n8n workflow grids, Cloudflare Edge workers, and self-correcting AI sandboxes, we eliminate human latency.'
  },
  {
    num: '03',
    metric: '24/7',
    metricLabel: 'AUTONOMOUS UPTIME',
    title: 'Certified & Self-Taught',
    detail: "Official n8n Workflow Specialist. Triple Oracle Cloud AI Certified. IBM SkillsBuild Cyber Specialist. Built by direct execution and verified in production.",
    extended: "Holding official credentials is just the baseline. The real proof is in the running code. We operate with deep, hands-on engineering principles across real infrastructure."
  },
  {
    num: '04',
    metric: '0',
    metricLabel: 'BUREAUCRACY DELAYS',
    title: 'Agile & Outcome-Driven',
    detail: "Direct access to the systems architect. Zero account managers, zero bureaucratic friction. That means faster turnaround and direct accountability.",
    extended: "Free from the bloat of traditional agency hierarchies and legacy processes. We deliver custom integrations in days rather than months."
  }
];

const MARQUEE_ITEMS = [
  '⚡ ZERO MANUAL ENTRY',
  '⚙ 24/7 AUTONOMOUS PIPELINES',
  '🛡️ TRIPLE ORACLE AI CERTIFIED',
  '🚀 99.98% EDGE UPTIME',
  '⚡ N8N WORKFLOW SPECIALIST',
  '🏢 ODOO + ERP DEPLOYMENTS',
];
---

<section id="why-primuez" class="pt-20 md:pt-32 pb-16 scroll-mt-20 overflow-hidden">
  <SectionHeader number="07" command="> diff --strategic ./agency ./primuez" title="Why Work With Primuez" />

  <p class="text-zinc-400 mt-2 mb-10 max-w-2xl text-base leading-relaxed font-sans">
    Direct execution over agency bloat. Built by someone who ships real code every single day.
  </p>

  {/* Velocity-Skewed Marquee Ribbon */}
  <div class="relative w-full overflow-hidden py-3 mb-12 border-y border-white/10 bg-black/40 backdrop-blur-md">
    <div class="marquee-track flex gap-8 whitespace-nowrap font-mono text-xs uppercase tracking-widest text-cyan font-bold select-none">
      {MARQUEE_ITEMS.concat(MARQUEE_ITEMS).map((text) => (
        <span class="inline-flex items-center gap-2">
          <span>{text}</span>
          <span class="text-amber">✦</span>
        </span>
      ))}
    </div>
  </div>

  {/* Metric Cards with High-End-Visual-Design Double Bezel */}
  <div id="why-items-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {WHY_ITEMS.map((item) => (
      <div class="why-card p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 via-white/[0.02] to-transparent border border-white/10 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:border-cyan/40">
        <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-7 flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between font-mono text-cyan text-xs font-bold mb-4">
              <span>// {item.num}</span>
              <div class="text-right">
                <span class="text-2xl sm:text-3xl font-extrabold text-amber block font-mono why-counter">{item.metric}</span>
                <span class="text-[9px] text-zinc-400 uppercase tracking-widest">{item.metricLabel}</span>
              </div>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white mb-2 font-sans">
              {item.title}
            </h3>

            <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-4 font-sans">
              {item.detail}
            </p>
          </div>

          <p class="text-zinc-400 text-xs leading-relaxed font-sans border-t border-white/[0.08] pt-3 mt-2">
            {item.extended}
          </p>
        </div>
      </div>
    ))}
  </div>

  {/* Fit Check Filter Container */}
  <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 via-white/[0.02] to-transparent border border-white/10 shadow-2xl backdrop-blur-xl">
    <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-8">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="font-mono text-xs uppercase tracking-widest text-amber font-bold">[ CRITICAL FILTER ]</span>
        <h3 class="text-2xl font-bold text-white mt-1 font-sans">Is This a Good Fit?</h3>
        <p class="text-zinc-400 text-xs sm:text-sm mt-1">I value both of our time. Let's verify mutual alignment up front.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Good Fit */}
        <div class="p-6 rounded-2xl bg-emerald-950/20 border border-emerald-500/30">
          <h4 class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-bold mb-4 flex items-center gap-2">
            <span>✅</span> Good Fit If You Are:
          </h4>
          <ul class="space-y-3 text-xs sm:text-sm text-zinc-300">
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold mt-0.5">•</span>
              <span>A business owner or operator drowning in manual data entry across ERPs, sheets, and web portals.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold mt-0.5">•</span>
              <span>A founder who needs production systems delivered fast without layers of agency management.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold mt-0.5">•</span>
              <span>Ready to automate operations to scale capacity and eliminate human friction.</span>
            </li>
          </ul>
        </div>

        {/* Not a Fit */}
        <div class="p-6 rounded-2xl bg-rose-950/20 border border-rose-500/30">
          <h4 class="font-mono text-xs uppercase tracking-wider text-rose-400 font-bold mb-4 flex items-center gap-2">
            <span>❌</span> Not a Fit If You Want:
          </h4>
          <ul class="space-y-3 text-xs sm:text-sm text-zinc-300">
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold mt-0.5">•</span>
              <span>A cheap bot from an unverified bidder who cuts corners on security and error logging.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold mt-0.5">•</span>
              <span>Weeks of bureaucratic committee meetings and slide decks instead of shipping working code.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-400 font-bold mt-0.5">•</span>
              <span>Speculative theoretical research with no clear business milestone or ROI.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#why-primuez');
    const cards = document.querySelectorAll('.why-card');
    const marquee = document.querySelector('.marquee-track');

    if (section && cards.length) {
      // 1. Staggered card entrance
      gsap.from(cards, {
        y: 40,
        opacity: 0,
        stagger: 0.15,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#why-items-grid',
          start: 'top 85%',
        },
      });

      // 2. Velocity-skewed marquee continuous translation
      if (marquee) {
        gsap.to(marquee, {
          xPercent: -50,
          repeat: -1,
          duration: 25,
          ease: 'none',
        });
      }
    }
  }
</script>
