---
import SectionHeader from './SectionHeader.astro';

const TIERS = [
  {
    tier: 'Professional Automation',
    code: 'TIER_01 // STARTER',
    usd: 'Starts at $150',
    inr: '₹12,000+',
    color: 'cyan',
    desc: 'Multi-step workflows, API connectors & CRM pipelines. Handover call + docs.',
    features: [
      'Multi-step n8n pipelines & CRM integrations',
      'Robust error handling & Discord/Telegram alerts',
      '3-6 node workflow or dedicated single-purpose agent',
      'Architecture documentation + recorded handover call',
      '30-day comprehensive post-launch SLA support',
    ],
    cta: 'Get Professional Build',
    url: 'https://cal.com/prime-s/30min',
  },
  {
    tier: 'Premium AI Integration',
    code: 'TIER_02 // FLAGSHIP',
    usd: '$300 - $800',
    inr: '₹25,000 - ₹65,000',
    color: 'amber',
    popular: true,
    desc: 'End-to-end AI systems, multi-model RAG pipelines & production SaaS MVPs.',
    features: [
      'End-to-end autonomous AI cognitive layers',
      'Multi-model fallback orchestration (Gemini/DeepSeek)',
      'SaaS MVPs & enterprise data pipelines on Cloudflare/VPS',
      'Full system architecture ownership & Docker deployment',
      'Unlimited minor revisions within project scope',
    ],
    cta: 'Build Flagship System',
    url: 'https://cal.com/prime-s/30min',
  },
  {
    tier: 'Advanced Enterprise Systems',
    code: 'TIER_03 // SCALE',
    usd: 'Up to $1,000',
    inr: '₹75,000 - ₹1,00,000+',
    color: 'violet',
    desc: 'High-level multi-department automation with complete architectural control.',
    features: [
      'Complex cross-system ERP & accounting automations',
      'Custom webhook security & token lifecycle managers',
      'Full architecture ownership & self-hosted setups',
      'Priority async communications via Telegram/WhatsApp',
      'Continuous performance tuning & roadmap planning',
    ],
    cta: 'Discuss Enterprise Scope',
    url: 'https://cal.com/prime-s/30min',
  },
];
---

<section id="pricing" class="pt-20 md:pt-32 pb-16 scroll-mt-20 overflow-hidden">
  <SectionHeader number="06" command="> ./pricing --fixed-scope" title="Transparent Pricing & Scopes" />

  <p class="text-zinc-400 mt-2 mb-12 max-w-2xl text-base leading-relaxed font-sans">
    Fixed scopes, guaranteed milestones. Zero hourly billing surprises or unexpected overhead.
  </p>

  {/* Tiered Terminal Enclosures with Double-Bezel Framing */}
  <div id="pricing-deck" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12" style="perspective: 1200px;">
    {TIERS.map((t) => (
      <div class={`pricing-card-enclosure p-1.5 rounded-[2rem] bg-gradient-to-b ${
        t.popular
          ? 'from-amber/40 via-white/10 to-transparent border border-amber/40 shadow-[0_20px_50px_rgba(245,166,35,0.15)]'
          : 'from-white/10 via-white/[0.02] to-transparent border border-white/10 shadow-2xl'
      } backdrop-blur-xl transition-all duration-300 hover:border-cyan/50 hover:-translate-y-1`}>
        
        <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-7 flex flex-col justify-between h-full relative overflow-hidden">
          {t.popular && (
            <div class="absolute top-4 right-4 bg-amber text-black font-mono text-[9px] uppercase font-bold tracking-widest px-2.5 py-1 rounded-full shadow-md">
              MOST POPULAR
            </div>
          )}

          <div>
            <span class="font-mono text-[10px] uppercase tracking-widest text-cyan font-bold block mb-2">
              {t.code}
            </span>
            <h3 class="text-xl font-bold text-white font-sans mb-3">
              {t.tier}
            </h3>

            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-3xl sm:text-4xl font-extrabold font-mono text-white">{t.usd}</span>
            </div>
            <span class="text-xs font-mono text-amber block mb-4">INR: {t.inr}</span>

            <p class="text-zinc-400 text-xs sm:text-sm mb-6 leading-relaxed font-sans">{t.desc}</p>

            <ul class="space-y-3 mb-8 border-t border-white/[0.08] pt-6 font-sans text-xs text-zinc-300">
              {t.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <span class={t.popular ? 'text-amber font-bold' : 'text-cyan font-bold'}>✓</span>
                  <span class="leading-relaxed">{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={t.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-4 rounded-xl font-mono text-xs uppercase tracking-widest text-center transition-all duration-200 font-bold block ${
              t.popular
                ? 'bg-amber text-black hover:bg-amber/90 shadow-[0_0_20px_rgba(245,166,35,0.3)]'
                : 'bg-white/5 hover:bg-cyan hover:text-black text-white border border-white/10 hover:border-cyan'
            }`}
          >
            {t.cta} &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

  {/* Retainer Card with High-End-Visual-Design Double Bezel */}
  <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-cyan/20 via-white/[0.04] to-transparent border border-white/10 shadow-2xl backdrop-blur-xl">
    <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <span class="font-mono text-xs uppercase tracking-widest text-cyan font-bold">[ ONGOING PARTNERSHIP ]</span>
        <h3 class="text-xl sm:text-2xl font-bold text-white mt-1 font-sans">Monthly Retainer &amp; Fractional Automation CTO</h3>
        <p class="text-zinc-400 text-xs sm:text-sm mt-1.5 max-w-xl leading-relaxed">
          Dedicated automation pipeline ownership, rapid response SLAs, weekly architectural reviews, and continuous workflow optimization.
        </p>
      </div>
      <a
        href="https://cal.com/prime-s/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3.5 bg-cyan/15 hover:bg-cyan hover:text-black border border-cyan/40 text-cyan text-xs font-mono uppercase tracking-widest rounded-xl transition-all duration-300 font-bold shrink-0 shadow-[0_0_15px_rgba(0,240,255,0.15)]"
      >
        Discuss Retainer &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const deck = document.querySelector('#pricing-deck');
    const cards = document.querySelectorAll('.pricing-card-enclosure');

    if (deck && cards.length) {
      gsap.from(cards, {
        y: 40,
        opacity: 0,
        stagger: 0.15,
        duration: 0.85,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: deck,
          start: 'top 85%',
        },
      });
    }
  }
</script>
