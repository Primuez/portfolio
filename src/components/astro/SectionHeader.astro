---
interface Props {
  number: string;
  command: string;
  title: string;
  center?: boolean;
}

const { number, command, title, center = false } = Astro.props;
---

<div class={`mb-8 md:mb-12 ${center ? 'text-center' : ''}`}>
  <div class={`flex items-center gap-2 font-mono text-xs text-text-muted mb-2 tracking-wider ${center ? 'justify-center' : ''}`}>
    <span class="text-cyan font-bold">[{number}]</span>
    <span>{command}</span>
  </div>
  <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold font-sans tracking-tight text-white">
    {title}
  </h2>
  <div class={`mt-3 h-0.5 w-16 bg-gradient-to-r from-cyan to-transparent ${center ? 'mx-auto' : ''}`}></div>
</div>
