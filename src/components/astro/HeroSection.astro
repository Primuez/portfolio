---
// Zero-JS Hero Section
---

<section id="hero" class="min-h-[100dvh] flex flex-col justify-center pt-24 md:pt-20 pb-12 relative overflow-hidden">
  {/* Cyber radial glow background */}
  <div class="absolute top-1/3 -left-32 w-96 h-96 bg-cyan/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-amber/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-4xl relative z-10">
    {/* Micro banner */}
    <a
      href="#process"
      class="inline-flex items-center gap-2 font-mono text-amber/90 text-xs md:text-sm mb-5 hover:text-amber transition-colors duration-200 py-1"
    >
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="opacity-90">See how a manufacturer eliminated 3 hours of daily manual entry &rarr;</span>
    </a>

    {/* Terminal typing line */}
    <div class="h-8 md:h-10 mb-4 font-mono text-xl md:text-2xl text-cyan flex items-center overflow-hidden">
      <span class="opacity-70 mr-2 text-text-muted select-none">&gt;</span>
      <span id="hero-phrase" class="transition-opacity duration-300">Workflow Automation.</span>
    </div>

    {/* Main Headline */}
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] md:leading-[1.12] mb-6 tracking-tight font-sans">
      I Build Autonomous Systems <br />
      <span class="shader-text-iridescent font-bold">That Give You Your Time Back.</span>
    </h1>

    {/* Subtitle */}
    <p class="text-text-muted text-base sm:text-lg lg:text-xl max-w-2xl mb-4 leading-relaxed font-sans text-balance">
      From AI agents that handle tax and legal queries to n8n pipelines that eliminate manual data entry — systems built and running.
    </p>

    <div class="font-mono text-xs text-amber/95 mb-8 border-l-2 border-amber/50 pl-3 leading-relaxed max-w-2xl">
      InkTwin and PrimuezSure — live SaaS products built and running. Tax Advisor and Legal Advisor agents — deployed and working.
    </div>

    {/* CTA Button Row */}
    <div class="flex flex-col sm:flex-row gap-3 md:gap-4 mb-8">
      <a
        href="#projects"
        class="px-8 py-4 bg-transparent border border-white/20 text-white font-mono text-sm uppercase tracking-widest hover:border-cyan/60 hover:text-cyan transition-all duration-300 text-center flex items-center justify-center gap-2 rounded-lg"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        View My Work
      </a>

      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('open-modal', { detail: { type: 'form' } }))"
        class="glass-btn-glow px-8 py-4 bg-cyan/10 border border-cyan/50 text-cyan hover:bg-cyan hover:text-bg font-mono text-sm uppercase tracking-widest transition-all duration-300 text-center font-bold flex items-center justify-center gap-2 rounded-lg cursor-pointer shadow-[0_0_20px_rgba(0,240,255,0.2)]"
      >
        Let's Talk
      </button>

      <a
        href="/documents/resume.pdf"
        download="Rahul_Kasturiya_Resume.pdf"
        class="px-8 py-4 bg-transparent border border-amber/40 text-amber font-mono text-sm uppercase tracking-widest hover:bg-amber/10 hover:border-amber/60 transition-all duration-300 text-center flex items-center justify-center gap-2 rounded-lg"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Resume
      </a>
    </div>

    {/* Direct Call Scheduler Box */}
    <div class="flex flex-col gap-3 max-w-xl mb-8 border border-white/10 bg-panel/70 p-5 rounded-xl backdrop-blur-md relative z-10 shadow-lg">
      <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted mb-1">[ OR SCHEDULE A DIRECT CALL ]</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="https://cal.com/prime-s/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 px-5 py-3.5 bg-cyan/10 border border-cyan/40 text-cyan hover:bg-cyan hover:text-bg font-mono text-xs uppercase tracking-wider text-center transition-all duration-300 flex items-center justify-center gap-2 font-bold rounded-lg"
        >
          📅 Book 30-min Scope Call
        </a>
        <a
          href="https://cal.com/prime-s/15min"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 px-5 py-3.5 bg-transparent border border-white/20 text-white hover:border-cyan/50 hover:text-cyan font-mono text-xs uppercase tracking-wider text-center transition-all duration-300 flex items-center justify-center gap-2 font-bold rounded-lg"
        >
          ☕ 15-min Quick Chat
        </a>
      </div>
      <p class="text-zinc-400 text-xs mt-1 text-center sm:text-left font-sans leading-normal">
        Prefer a quick call? No sales pitch — just scope your project.
      </p>
    </div>

    {/* Social Proof Badges */}
    <div class="flex flex-wrap gap-3 font-mono text-xs">
      <span class="bg-panel/90 border border-white/10 text-text-muted px-3.5 py-2 rounded-lg flex items-center gap-2">
        <span class="text-amber">⚙</span> 10+ Businesses Automated
      </span>
      <span class="bg-panel/90 border border-white/10 text-text-muted px-3.5 py-2 rounded-lg flex items-center gap-2">
        <span class="text-cyan">⚡</span> 10+ Systems Running 24/7
      </span>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const phrases = [
      "Workflow Automation.",
      "Zero Manual Entry.",
      "Systems That Scale.",
      "Built for Indian SMEs."
    ];
    let idx = 0;
    const el = document.getElementById('hero-phrase');
    if (!el) return;
    setInterval(() => {
      idx = (idx + 1) % phrases.length;
      el.style.opacity = '0';
      setTimeout(() => {
        el.textContent = phrases[idx];
        el.style.opacity = '1';
      }, 200);
    }, 3200);
  })();
</script>
