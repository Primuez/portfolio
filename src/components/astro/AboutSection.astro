---
import SectionHeader from './SectionHeader.astro';
---

<section id="whoami" class="relative py-24 md:py-32 overflow-hidden scroll-mt-20">
  <SectionHeader number="01" command="> whoami --verbose" title="Architecting Autonomy" />

  {/* Pinned scrubbed narrative statement (Word-by-word luminous scroll reveal) */}
  <div class="mb-14 max-w-4xl about-narrative-container">
    <p class="font-sans text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold leading-relaxed tracking-tight text-zinc-400 about-scrub-text">
      <span class="scrub-word inline-block mr-1.5 transition-opacity">"I</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">engineer</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">autonomous</span>
      <span class="scrub-word inline-block mr-1.5 text-white transition-opacity">agents</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">and</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">zero-friction</span>
      <span class="scrub-word inline-block mr-1.5 text-cyan transition-opacity">n8n</span>
      <span class="scrub-word inline-block mr-1.5 text-cyan transition-opacity">pipelines</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">connecting</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">Odoo,</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">databases,</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">and</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">APIs</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">so</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">expensive</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">human</span>
      <span class="scrub-word inline-block mr-1.5 transition-opacity">latencies</span>
      <span class="scrub-word inline-block mr-1.5 text-amber transition-opacity">completely</span>
      <span class="scrub-word inline-block mr-1.5 text-amber transition-opacity">disappear."</span>
    </p>
  </div>

  {/* Bento Grid with High-End-Visual-Design Double-Bezel Architecture */}
  <div id="about-bento-grid" class="grid grid-cols-1 md:grid-cols-12 gap-6 relative z-10">
    
    {/* Card 01: Operator Creed (Double-Bezel Outer Shell + Machined Inner Core) */}
    <div class="md:col-span-7 about-bento-card p-1.5 rounded-[2rem] bg-gradient-to-b from-white/[0.08] via-white/[0.02] to-transparent border border-white/10 shadow-2xl">
      <div class="rounded-[calc(2rem-0.375rem)] bg-[#070a12]/95 p-6 sm:p-8 h-full flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 font-mono text-[11px] text-zinc-400 border-b border-white/[0.06] pb-3 mb-5">
            <span class="text-cyan font-bold">[ 01 ]</span>
            <span class="text-zinc-200 font-semibold uppercase tracking-wider">OPERATOR_CREED</span>
            <span class="text-purple-400 ml-auto font-mono text-xs">ROOT // 01</span>
          </div>

          <blockquote class="text-white italic text-base md:text-lg border-l-2 border-cyan/60 pl-4 py-1 leading-relaxed font-sans mb-4">
            &quot;Self-taught. No CS degree. No team. Everything here was built by directly doing — from central India, one working pipeline at a time.&quot;
          </blockquote>

          <p class="text-zinc-300 text-sm leading-relaxed font-sans mb-6">
            I believe in engineering verified blueprints over theoretical ideals. Production deployments should be resilient, scalable, and completely autonomic.
          </p>
        </div>

        <div class="bg-black/60 p-4 rounded-xl border border-white/[0.06] font-mono text-xs text-zinc-300 space-y-1.5">
          <div class="text-emerald-400 font-semibold">$&gt; primuez --execute-creed</div>
          <div>[SUCCESS] PRACTICALITY_OVER_HYPOTHESIS = TRUE</div>
          <div>[SUCCESS] BARE_METAL_AUTONOMY = ACTIVE</div>
          <div class="text-zinc-400">// Raipur Core Center // रायपुर, छ.ग.</div>
        </div>
      </div>
    </div>

    {/* Card 02: Autonomic Brain / Live Telemetry */}
    <div class="md:col-span-5 about-bento-card p-1.5 rounded-[2rem] bg-gradient-to-b from-cyan/20 via-white/[0.02] to-transparent border border-white/10 shadow-2xl">
      <div class="rounded-[calc(2rem-0.375rem)] bg-[#070a12]/95 p-6 sm:p-8 h-full flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 font-mono text-[11px] text-zinc-400 border-b border-white/[0.06] pb-3 mb-5">
            <span class="text-cyan font-bold">[ 02 ]</span>
            <span class="text-zinc-200 font-semibold uppercase tracking-wider">AUTONOMIC_BRAIN</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 ml-auto animate-pulse"></span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight font-sans mb-3">
            Rahul Kasturiya
            <span class="text-cyan block text-sm font-mono mt-1 font-normal">&gt; handle: @Primuez</span>
          </h3>

          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed font-sans mb-5">
            Founder of InkTwin &amp; PrimuezSure. Triple Oracle Certified AI Developer &amp; n8n Specialist with live systems running 24/7.
          </p>
        </div>

        <div class="flex flex-col gap-2 p-4 bg-black/50 border border-white/[0.05] rounded-xl font-mono text-xs text-zinc-300">
          <div class="flex justify-between items-center">
            <span>STATUS:</span>
            <span class="text-cyan font-bold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan animate-ping"></span>
              ACTIVE ENGINE
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span>LOCATION:</span>
            <span class="text-white">RAIPUR CORE // INDIA</span>
          </div>
          <div class="flex justify-between items-center">
            <span>UPTIME:</span>
            <span class="text-emerald-400 font-bold">99.98% 24/7</span>
          </div>
        </div>
      </div>
    </div>

    {/* Card 03: System Specs Matrix (4 Columns) */}
    <div class="md:col-span-12 about-bento-card p-1.5 rounded-[2rem] bg-gradient-to-b from-white/[0.06] via-transparent to-transparent border border-white/10 shadow-2xl">
      <div class="rounded-[calc(2rem-0.375rem)] bg-[#070a12]/95 p-6 sm:p-8">
        <div class="flex items-center gap-2 font-mono text-[11px] text-zinc-400 border-b border-white/[0.06] pb-3 mb-5">
          <span class="text-amber font-bold">[ 03 ]</span>
          <span class="text-zinc-200 font-semibold uppercase tracking-wider">HARDWARE_&amp;_EXECUTION_SPECS</span>
          <span class="text-amber ml-auto font-mono text-xs">SPEC // 2026</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 bg-white/[0.02] border border-white/[0.05] rounded-2xl hover:border-cyan/30 transition-colors">
            <span class="text-cyan font-mono text-[10px] uppercase tracking-widest block mb-1">Focus Domain</span>
            <span class="text-white text-sm font-bold block leading-tight">AI &amp; n8n Automation</span>
            <span class="text-zinc-400 text-xs block mt-1">Autonomous Workflows</span>
          </div>

          <div class="p-4 bg-white/[0.02] border border-white/[0.05] rounded-2xl hover:border-rose-400/30 transition-colors">
            <span class="text-rose-400 font-mono text-[10px] uppercase tracking-widest block mb-1">Base of Operations</span>
            <span class="text-white text-sm font-bold block leading-tight">Raipur / Durg, CG</span>
            <span class="text-zinc-400 text-xs block mt-1">Central India HQ</span>
          </div>

          <div class="p-4 bg-white/[0.02] border border-white/[0.05] rounded-2xl hover:border-purple-400/30 transition-colors">
            <span class="text-purple-400 font-mono text-[10px] uppercase tracking-widest block mb-1">Foundation</span>
            <span class="text-white text-sm font-bold block leading-tight">SSIPS (BCA)</span>
            <span class="text-zinc-400 text-xs block mt-1">Computer Applications</span>
          </div>

          <div class="p-4 bg-white/[0.02] border border-white/[0.05] rounded-2xl hover:border-emerald-400/30 transition-colors">
            <span class="text-emerald-400 font-mono text-[10px] uppercase tracking-widest block mb-1">Dialects</span>
            <span class="text-white text-sm font-bold block leading-tight">Hindi · English · Sindhi</span>
            <span class="text-zinc-400 text-xs block mt-1">Multilingual Systems</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const whoamiSection = document.querySelector('#whoami');
    const scrubWords = document.querySelectorAll('.scrub-word');
    const bentoCards = document.querySelectorAll('.about-bento-card');

    if (whoamiSection) {
      // 1. Pinned word-by-word scrub illumination
      gsap.fromTo(
        scrubWords,
        { opacity: 0.2, filter: 'blur(1px)' },
        {
          opacity: 1,
          filter: 'blur(0px)',
          stagger: 0.08,
          scrollTrigger: {
            trigger: '.about-narrative-container',
            start: 'top 80%',
            end: 'bottom 40%',
            scrub: 0.5,
          },
        }
      );

      // 2. Bento cards assembling entrance
      gsap.from(bentoCards, {
        scrollTrigger: {
          trigger: '#about-bento-grid',
          start: 'top 85%',
        },
        y: 60,
        opacity: 0,
        stagger: 0.15,
        duration: 0.9,
        ease: 'power3.out',
      });
    }
  }
</script>
