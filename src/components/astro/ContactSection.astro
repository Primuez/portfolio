---
import SectionHeader from './SectionHeader.astro';

const SOCIALS = [
  { label: '15-Min Quick Chat', href: 'https://cal.com/prime-s/15min', icon: '15', highlight: 'cyan' },
  { label: '30-Min Scope Call', href: 'https://cal.com/prime-s/30min', icon: '30', highlight: 'amber' },
  { label: 'GitHub (primuez)', href: 'https://github.com/primuez', icon: 'GH' },
  { label: 'GitHub (primmius)', href: 'https://github.com/primmius', icon: 'GH2' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/rahul-kasturiya-796910363', icon: 'IN' },
  { label: 'X / Twitter', href: 'https://x.com/Primuez', icon: 'X' },
  { label: 'Telegram Direct', href: 'https://t.me/Primuez', icon: 'TG', highlight: 'cyan' },
  { label: 'WhatsApp', href: 'https://wa.me/917024637099', icon: 'WA', highlight: 'amber' },
  { label: 'Ko-fi Support', href: 'https://ko-fi.com/primuez', icon: '☕' },
  { label: 'Upwork Profile', href: 'https://www.upwork.com/freelancers/~012ee7737a8d40746f', icon: 'UP' },
];
---

<section id="contact" class="pt-24 md:pt-36 pb-24 text-center scroll-mt-20 overflow-hidden contact-zoom-section">
  <SectionHeader number="12" command="> ./contact --init" title="Connect & Scope" center />

  <p class="text-zinc-400 mt-2 mb-12 max-w-xl mx-auto text-base leading-relaxed font-sans">
    Ready to eliminate manual operations or deploy an autonomous agent? Let's talk directly.
  </p>

  {/* Interactive Terminal Console with Double-Bezel Framing & Zoom-Through Scrub */}
  <div class="contact-terminal-box max-w-3xl mx-auto p-1.5 rounded-[2.5rem] bg-gradient-to-b from-cyan/30 via-white/10 to-transparent border border-cyan/40 shadow-[0_25px_70px_rgba(0,240,255,0.18)] mb-12 backdrop-blur-2xl">
    <div class="rounded-[calc(2.5rem-0.375rem)] bg-[#070b12]/95 p-8 sm:p-12 relative overflow-hidden">
      
      {/* Top Terminal Status Header */}
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-8 font-mono text-xs text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-white font-bold">TERMINAL // DIRECT_LINE</span>
        </div>
        <span class="text-cyan">PORT: 443 [ENCRYPTED]</span>
      </div>

      <h3 class="text-2xl sm:text-4xl font-extrabold text-white mb-3 font-sans">
        Send Your System Requirements
      </h3>
      
      <p class="text-zinc-300 text-xs sm:text-base mb-8 max-w-lg mx-auto leading-relaxed font-sans">
        Fill out the project scope questionnaire. I review all technical architecture specs personally and respond within 24 hours.
      </p>

      {/* Action Buttons: Form Trigger + Magnetic Direct Email */}
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 max-w-xl mx-auto">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-modal', { detail: { type: 'form' } }))"
          class="w-full sm:w-auto px-8 py-4 bg-cyan text-black hover:bg-cyan/90 font-mono text-xs uppercase tracking-widest rounded-xl transition-all duration-300 font-bold shadow-[0_0_30px_rgba(0,240,255,0.35)] cursor-pointer magnetic-cta"
        >
          Open Project Form &rarr;
        </button>

        <div class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-4 bg-white/5 border border-white/10 rounded-xl font-mono text-xs text-zinc-300">
          <span>Email:</span>
          <a href="mailto:contact@primuez.in" class="text-cyan hover:underline font-bold">contact@primuez.in</a>
          <button
            type="button"
            id="copy-email-btn"
            class="ml-2 px-2.5 py-1 bg-white/10 hover:bg-white/20 text-white rounded text-[10px] uppercase font-bold transition-colors cursor-pointer"
            title="Copy email"
          >
            Copy
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Multi-channel Social Badges */}
  <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
    {SOCIALS.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`px-4 py-2.5 rounded-xl font-mono text-xs uppercase tracking-wider flex items-center gap-2 border transition-all duration-300 ${
          s.highlight === 'cyan'
            ? 'bg-cyan/10 border-cyan/40 text-cyan hover:bg-cyan hover:text-black shadow-[0_0_15px_rgba(0,240,255,0.2)]'
            : s.highlight === 'amber'
              ? 'bg-amber/10 border-amber/40 text-amber hover:bg-amber hover:text-black shadow-[0_0_15px_rgba(245,166,35,0.2)]'
              : 'bg-white/5 border-white/10 text-zinc-300 hover:border-cyan/40 hover:text-white'
        }`}
      >
        <span class="font-bold">{s.icon}</span>
        <span>{s.label}</span>
      </a>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('.contact-zoom-section');
    const terminalBox = document.querySelector('.contact-terminal-box');

    if (section && terminalBox) {
      // Pinned Zoom-Through entrance scrub (scale: 0.92 -> 1.02)
      gsap.fromTo(
        terminalBox,
        { scale: 0.92, opacity: 0.7 },
        {
          scale: 1.02,
          opacity: 1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 80%',
            end: 'top 30%',
            scrub: 0.5,
          },
        }
      );
    }
  }

  // Copy email action
  document.getElementById('copy-email-btn')?.addEventListener('click', function (this: HTMLButtonElement) {
    navigator.clipboard.writeText('contact@primuez.in');
    const prev = this.textContent;
    this.textContent = '✓ Copied';
    setTimeout(() => {
      this.textContent = prev;
    }, 2000);
  });
</script>
