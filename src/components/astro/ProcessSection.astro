---
import SectionHeader from './SectionHeader.astro';

const STEPS = [
  { step: '01', title: 'Discovery & Audit', phase: 'INPUT_STREAM', desc: "You describe your goal or identify the repetitive bottlenecks draining manual team hours. We review your tools and data schemas.", icon: '◎' },
  { step: '02', title: 'Fixed-Price Blueprint', phase: 'SCOPE_LOCK', desc: 'Within 24–48 hours, I deliver a verified architecture specification with guaranteed fixed pricing. Zero hourly billing creep.', icon: '▤' },
  { step: '03', title: 'Build & Sandbox QA', phase: 'AUTONOMOUS_COMPILE', desc: 'I build in fast, verifiable stages with live sandbox testing and webhook validation, keeping you informed at every milestone.', icon: '⟳' },
  { step: '04', title: 'Production Handover', phase: 'EDGE_DEPLOY', desc: 'Full live deployment + self-hosted credentials + thorough architecture walkthrough recording so you have 100% ownership.', icon: '↗' },
  { step: '05', title: '30-Day Free SLA', phase: 'MAINTENANCE_LOOP', desc: '30 days of comprehensive zero-cost bug fixes, edge-case tuning, and SLA support included with every production delivery.', icon: '❖' },
];
---

<section id="process" class="pt-20 md:pt-32 pb-16 scroll-mt-20 overflow-hidden">
  <SectionHeader number="05" command="> cat /etc/workflow/pipeline.conf" title="How We Work Together" />

  <p class="text-zinc-400 mt-2 mb-12 max-w-2xl text-base leading-relaxed font-sans">
    Disciplined, transparent, and outcome-engineered. From system discovery to autonomous execution in production.
  </p>

  {/* Central Circuit Timeline with Interlocking Nodes & Glowing SVG Spine */}
  <div id="process-timeline-container" class="relative max-w-5xl mx-auto py-4">
    
    {/* Center SVG Power Spine (Desktop centered, Mobile left-aligned) */}
    <div class="absolute left-6 md:left-1/2 -translate-x-1/2 top-0 bottom-0 w-8 flex flex-col items-center pointer-events-none z-0">
      <svg class="w-full h-full" preserveAspectRatio="none">
        <line x1="50%" y1="0" x2="50%" y2="100%" stroke="rgba(255,255,255,0.08)" stroke-width="2" />
        <line id="svg-spine-fill" x1="50%" y1="0" x2="50%" y2="100%" stroke="url(#spine-grad)" stroke-width="3" stroke-linecap="round" />
        <defs>
          <linearGradient id="spine-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#00f0ff" />
            <stop offset="70%" stop-color="#00f0ff" />
            <stop offset="100%" stop-color="#fbbf24" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    {/* Interlocking Step Nodes Flanking the Spine */}
    <div class="space-y-12 relative z-10">
      {STEPS.map((s, idx) => {
        const isEven = idx % 2 === 0;
        return (
          <div class={`process-step-node relative flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 ${
            isEven ? 'md:flex-row' : 'md:flex-row-reverse'
          } group`}>
            
            {/* Step Card (Occupies 50% on desktop) */}
            <div class={`w-full md:w-[calc(50%-3rem)] pl-14 md:pl-0 ${isEven ? 'md:text-right' : 'md:text-left'}`}>
              <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 via-white/[0.02] to-transparent border border-white/10 shadow-2xl backdrop-blur-xl group-hover:border-cyan/40 transition-all duration-300">
                <div class="rounded-[calc(2rem-0.375rem)] bg-[#070b12]/95 p-6 sm:p-7">
                  <div class={`flex items-center gap-2 mb-2 ${isEven ? 'md:justify-end' : 'md:justify-start'}`}>
                    <span class="font-mono text-cyan text-[10px] uppercase tracking-widest bg-cyan/10 border border-cyan/25 px-2.5 py-0.5 rounded-full font-bold">
                      {s.phase}
                    </span>
                    <span class="text-zinc-500 font-mono text-xs">{s.icon}</span>
                  </div>

                  <h3 class="text-xl sm:text-2xl font-bold text-white font-sans mb-2 group-hover:text-cyan transition-colors">
                    {s.title}
                  </h3>

                  <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed font-sans">
                    {s.desc}
                  </p>
                </div>
              </div>
            </div>

            {/* Central Beacon Node on the Spine */}
            <div class="absolute left-6 md:left-1/2 -translate-x-1/2 top-4 md:top-auto w-12 h-12 rounded-full bg-[#070b12] border-2 border-cyan/40 group-hover:border-cyan flex items-center justify-center font-mono text-cyan text-sm font-bold shadow-[0_0_20px_rgba(0,240,255,0.25)] group-hover:shadow-[0_0_30px_rgba(0,240,255,0.6)] group-hover:scale-110 transition-all duration-300 z-20">
              <span class="beacon-number">{s.step}</span>
            </div>

            {/* Empty Spacer Column for the opposite side on desktop */}
            <div class="hidden md:block w-[calc(50%-3rem)]"></div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { shouldReduceMotion } from '../../lib/motion';

  if (!shouldReduceMotion()) {
    gsap.registerPlugin(ScrollTrigger);

    const container = document.querySelector('#process-timeline-container');
    const spineFill = document.querySelector('#svg-spine-fill');
    const stepNodes = document.querySelectorAll('.process-step-node');

    if (container && spineFill) {
      // 1. Scroll-fill SVG Spine Line
      gsap.fromTo(
        spineFill,
        { strokeDasharray: 2000, strokeDashoffset: 2000 },
        {
          strokeDashoffset: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: container,
            start: 'top 75%',
            end: 'bottom 85%',
            scrub: 0.5,
          },
        }
      );

      // 2. Staggered Checkpoint Node Entrances
      stepNodes.forEach((node) => {
        gsap.from(node, {
          y: 45,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: node,
            start: 'top 85%',
          },
        });
      });
    }
  }
</script>
