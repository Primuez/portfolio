---
import SectionHeader from './SectionHeader.astro';

const STEPS = [
  { step: '01', title: 'Discovery', desc: "You describe your goal or the process that's slowing you down.", icon: '◎' },
  { step: '02', title: 'Proposal', desc: 'I send a clear scope with a fixed price. No hourly surprises. (1–2 days)', icon: '▤' },
  { step: '03', title: 'Build & Iterate', desc: 'I build in small iterations and share progress with you throughout.', icon: '⟳' },
  { step: '04', title: 'Handover', desc: 'Live system + full documentation + a training session so you own it completely.', icon: '↗' },
  { step: '05', title: 'Support', desc: '30 days of free bug fixes and adjustments included after launch.', icon: '❖' },
];
---

<section id="process" class="pt-16 md:pt-28 scroll-mt-20">
  <SectionHeader number="05" command="> cat /etc/workflow/pipeline.conf" title="How We Work Together" />

  <p class="text-zinc-400 mt-2 mb-10 max-w-2xl text-base leading-relaxed font-sans">
    Simple, transparent, and outcome-focused. From scope to running autonomous systems.
  </p>

  <div id="process-timeline-container" class="relative max-w-4xl mx-auto">
    {/* Animated Center spine on desktop */}
    <div class="hidden md:block absolute left-8 top-6 bottom-6 w-0.5 bg-white/10 overflow-hidden">
      <div id="timeline-scroll-fill" class="w-full h-full bg-gradient-to-b from-cyan via-cyan to-amber-400 origin-top transform-gpu scale-y-0 shadow-[0_0_12px_rgba(0,240,255,0.6)]"></div>
    </div>

    <div class="space-y-6">
      {STEPS.map((s) => (
        <div class="process-step-row relative flex items-start gap-4 md:gap-8 group">
          {/* Node Badge */}
          <div class="process-node-badge shrink-0 w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-[#090b16] border-2 border-cyan/40 group-hover:border-cyan flex items-center justify-center font-mono text-cyan text-sm md:text-base font-bold shadow-[0_0_15px_rgba(0,240,255,0.15)] group-hover:shadow-[0_0_25px_rgba(0,240,255,0.35)] transition-all duration-300 z-10 transform-gpu">
            {s.step}
          </div>

          {/* Step Card */}
          <div class="process-step-card flex-1 p-5 sm:p-6 rounded-2xl bg-[#090d16]/90 border border-white/10 group-hover:border-cyan/40 transition-all duration-300 shadow-lg">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg md:text-xl font-bold text-white font-sans group-hover:text-cyan transition-colors">
                {s.title}
              </h3>
              <span class="text-zinc-500 font-mono text-sm">{s.icon}</span>
            </div>
            <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed font-sans">
              {s.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) {
      // 1. Scroll-fill spine timeline
      gsap.to('#timeline-scroll-fill', {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#process-timeline-container',
          start: 'top 75%',
          end: 'bottom 85%',
          scrub: 0.5,
        },
      });

      // 2. Staggered node entry
      gsap.fromTo(
        '.process-step-row',
        { opacity: 0, x: 25 },
        {
          opacity: 1,
          x: 0,
          duration: 0.6,
          stagger: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '#process-timeline-container',
            start: 'top 80%',
          },
        }
      );
    }
  }
</script>
