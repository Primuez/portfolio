---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/astro/SectionHeader.astro';
import HeroSection from '../components/astro/HeroSection.astro';
import AboutSection from '../components/astro/AboutSection.astro';
import ServicesSection from '../components/astro/ServicesSection.astro';
import ProcessSection from '../components/astro/ProcessSection.astro';
import WhySection from '../components/astro/WhySection.astro';
import PricingSection from '../components/astro/PricingSection.astro';
import StackSection from '../components/astro/StackSection.astro';
import GithubSection from '../components/astro/GithubSection.astro';
import VideosSection from '../components/astro/VideosSection.astro';
import ContactSection from '../components/astro/ContactSection.astro';
import Footer from '../components/astro/Footer.astro';

// Interactive Islands
import ProjectsIsland from '../components/islands/ProjectsIsland';
import FavoritesIsland from '../components/islands/FavoritesIsland';
import CredentialsIsland from '../components/islands/CredentialsIsland';
import FAQIsland from '../components/islands/FAQIsland';
---

<BaseLayout>
  <main id="main-content" aria-label="Portfolio content">
    <div class="relative z-10 w-full px-4 sm:px-6 md:px-12 max-w-7xl mx-auto pb-0">
      {/* 00. Hero Section (Zero-JS) */}
      <HeroSection />

      {/* 01. About Bento Grid (Zero-JS) */}
      <AboutSection />

      {/* 02. Projects & Personal Favorites (Islands) */}
      <section id="projects" class="pt-16 md:pt-28 scroll-mt-20">
        <SectionHeader number="02" command="> ./projects --what-i-built" title="What I've Actually Built and Shipped" />
        <p class="text-text-muted mt-2 mb-10 max-w-2xl text-base leading-relaxed font-sans">
          No fake case studies. These are real products and agents I built, own, and run. Expand any category, and inspect the verified architecture.
        </p>

        <ProjectsIsland client:visible />

        <div class="mt-8 text-center">
          <p class="font-mono text-xs text-amber border border-amber/35 bg-amber/5 px-4 py-3 rounded-lg inline-block shadow-[0_0_15px_rgba(245,166,35,0.1)]">
            🛡️ Presented automation architecture publicly at Odoo Business Show, Raipur.
          </p>
        </div>

        <FavoritesIsland client:visible />
      </section>

      {/* 03. Services & Capabilities (Zero-JS) */}
      <ServicesSection />

      {/* 04. Video Presentations & Channels (Zero-JS) */}
      <VideosSection />

      {/* 05. How We Work Together / Process (Zero-JS) */}
      <ProcessSection />

      {/* 06. Transparent Pricing & Retainers (Zero-JS) */}
      <PricingSection />

      {/* 07. Why Work With Primuez & Fit Filter (Zero-JS) */}
      <WhySection />

      {/* 08. Tech Stack & Infrastructure (Zero-JS) */}
      <StackSection />

      {/* 09. Verified Credentials & Certifications (Island) */}
      <section id="credentials" class="pt-16 md:pt-28 scroll-mt-20">
        <SectionHeader number="09" command="> ./credentials --verified" title="Credentials & Certifications" />
        <p class="text-text-muted mt-2 mb-8 max-w-2xl text-base leading-relaxed font-sans">
          Official credentials from Oracle, The Linux Foundation, and IBM SkillsBuild verifying autonomous agent engineering and cyber resilience.
        </p>

        <CredentialsIsland client:visible />
      </section>

      {/* 10. Open Source Repositories (Zero-JS) */}
      <GithubSection />

      {/* 11. Frequently Asked Questions (Island) */}
      <section id="faq" class="pt-16 md:pt-28 scroll-mt-20">
        <SectionHeader number="11" command="> man faq" title="Frequently Asked Questions" center />
        <FAQIsland client:visible />
      </section>

      {/* 12. Contact & Project Inquiries (Zero-JS) */}
      <ContactSection />
    </div>
  </main>

  {/* Footer (Zero-JS) */}
  <Footer />
</BaseLayout>
