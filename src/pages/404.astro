---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Signal Lost // Primuez">
  <div class="min-h-[80vh] flex flex-col items-center justify-center text-center px-4">
    <div class="font-mono text-cyan text-sm tracking-widest uppercase mb-4">
      [ 404 // SIGNAL_TERMINATED ]
    </div>
    <h1 class="text-4xl md:text-6xl font-bold font-sans text-white mb-4">
      Route Not Found
    </h1>
    <p class="text-text-muted text-sm md:text-base max-w-md mb-8 font-sans">
      The requested coordinates do not resolve to an active system pipeline.
    </p>
    <a
      href="/"
      class="px-8 py-3.5 bg-cyan/10 hover:bg-cyan hover:text-bg border border-cyan/40 text-cyan rounded-xl font-mono text-xs uppercase tracking-widest font-bold transition-all shadow-[0_0_20px_rgba(0,240,255,0.2)]"
    >
      Return to System Root &rarr;
    </a>
  </div>
</BaseLayout>
